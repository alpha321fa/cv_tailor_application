# Get a free key at https://openrouter.ai/keys
# Leave empty to run in demo mode (canned response, no network calls).
OPENROUTER_API_KEY=

# Optional: override the default model. Any OpenRouter model id works.
# Free models end in ":free" - see https://openrouter.ai/models?max_price=0
# LLM_MODEL=google/gemma-4-31b-it:free

# Optional: comma-separated backup models, tried in order if the main one is busy or errors.
# LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
